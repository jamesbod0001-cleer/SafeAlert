# ── SERVER ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── FIREBASE ─────────────────────────────────────────────
# Download from Firebase Console → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com
# Named Firestore DB (Firebase Console). Default in this project: safealert
FIRESTORE_DATABASE_ID=safealert

# ── AFRICA'S TALKING ─────────────────────────────────────
# Sandbox: username sandbox + sandbox API key + empty AT_SENDER_ID; whitelist phones in AT dashboard
# Production: your app username + production API key + approved AT_SENDER_ID
AT_USERNAME=sandbox
AT_API_KEY=your_sandbox_or_production_api_key
AT_SHORTCODE=
AT_SENDER_ID=

# ── SECURITY ─────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_min_64_chars
HASH_SECRET=another_long_random_secret_for_device_hashing
ENCRYPTION_KEY=32_char_key_for_aes_encryption!!

# ── FIREBASE WEB (FCM in browser — Firebase Console → Project settings → Your apps) ──
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_VAPID_KEY=

# ── CORS (production: comma-separated origins, no spaces) ──
CORS_ORIGINS=https://qrhtc5kg79.us-east-1.awsapprunner.com,https://safealertng.com

# ── RATE LIMITING ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_PANIC_MAX=3
RATE_LIMIT_LOCATION_MAX=12
PANIC_COOLDOWN_SEC=900

# ── APP (no hardcoded values in code — configure here or in Firestore app_settings/global) ──
APP_NAME=SafeAlert NG
APP_MAP_URL=https://safealertng.com
USSD_SERVICE_CODE=*384*911#
INCIDENT_TYPES=kidnapping,armed_robbery,banditry,terror,roadblock,suspicious,scam,one_chance,checkpoint
EMERGENCY_CONTACTS=[{"name":"Red Cross Nigeria","phone":"08026660000"},{"name":"Mental health line (Survivors)","phone":"08007887799"}]

# ── ALERTS & THRESHOLDS ──────────────────────────────────
USE_MEMORY_DB=false
# Lean / unfunded launch: fewer writes, FCM-first panic, no paid OpenAI
BUDGET_MODE=true
BUDGET_LOCATION_MIN_INTERVAL_SEC=1800
PANIC_SMS_FALLBACK_ONLY=true
PROXIMITY_ALERTS_ENABLED=true
PANIC_AUTO_BROADCAST_ENABLED=true
PANIC_SMS_ENABLED=true
PUSH_NOTIFICATIONS_ENABLED=true
CRITICAL_ZONE_RADIUS_KM=30
# Nearby strangers: FCM only. Set CRITICAL_ZONE_SMS_ENABLED=true + cap to allow SMS.
CRITICAL_ZONE_SMS_ENABLED=false
CRITICAL_ZONE_SMS_MAX=0
GEOHASH_CELL_LIMIT=500
NOTIFY_QUEUE_CONCURRENCY=3
PANIC_BROADCAST_RADIUS_KM=10
LOCATION_MIN_INTERVAL_SEC=300
LOCATION_TTL_MINUTES=45
HELP_NEARBY_MAX_RADIUS_KM=15
SEED_REVIEW_DATA=false
# DEV_FIXED_OTP=123456
ROUTE_SAFE_THRESHOLD=65
ROUTE_DANGER_THRESHOLD=35
ZONE_CLEAR_THRESHOLD=0.7
SEVERITY_THRESHOLD_LOW=1
SEVERITY_THRESHOLD_MEDIUM=3
SEVERITY_THRESHOLD_HIGH=5
SEVERITY_THRESHOLD_CRITICAL=10
USSD_MAX_ROUTES_MENU=5
USSD_MAX_ZONES_MENU=4

# Live incident data (ACLED) — register free at https://acleddata.com
ACLED_EMAIL=your@email.com
ACLED_PASSWORD=your_myacled_password
# Optional legacy API key (if OAuth not used):
# ACLED_API_KEY=
ACLED_LOOKBACK_DAYS=30
ACLED_SYNC_LIMIT=500
# HDX UCDP fallback (used when ACLED API returns 403)
HDX_UCDP_ENABLED=true
HDX_UCDP_LOOKBACK_DAYS=730
HDX_UCDP_SYNC_LIMIT=2000
LIVE_DATA_SYNC_ENABLED=true
LIVE_DATA_SYNC_INTERVAL_MS=21600000
LIVE_DATA_SYNC_INITIAL_DELAY_MS=180000
BLOCK_SIMULATED_DATA=true
DAILY_IMPORT_ENABLED=false
IMPORT_JOB_SECRET=change-me-to-a-long-random-string
# Admin moderation UI + API (X-Admin-Secret header; falls back to IMPORT_JOB_SECRET if unset)
ADMIN_SECRET=change-me-to-a-long-random-string

# AI insights summary (template works without OpenAI — free)
AI_INSIGHTS_ENABLED=true
# Set true only if you have OpenAI credits AND BUDGET_MODE=false
AI_INSIGHTS_USE_OPENAI=false
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# WhatsApp Cloud API webhook (Meta Business)
# WHATSAPP_VERIFY_TOKEN=your_verify_token
# WHATSAPP_WEBHOOK_SECRET=

# Telco zero-rating partnership info URL (optional)
# ZERO_RATING_INFO_URL=https://safealertng.com/zero-rating

# Firestore read optimization (reduce quota burn)
ZONES_MAX_PER_QUERY=300
ZONES_STATE_QUERY_LIMIT=250
STATS_CACHE_TTL_MS=900000
STATS_REBUILD_PAGE_SIZE=400
STATS_REBUILD_MAX_PAGES=8
ROUTES_MAX_LIST=100
GROUPS_MAX_LIST=80

# ── MOBILE APPS (web + Flutter) ───────────────────────────
# Public/mobile API URL used by web/mobile config helpers
MOBILE_API_URL=https://api.safealertng.com/v1
# Set when published to stores (shown in app + download page)
IOS_APP_STORE_URL=
ANDROID_PLAY_STORE_URL=
# Optional: direct APK for sideload before Play Store approval
ANDROID_APK_URL=
# Apple smart banner (numeric App Store ID, e.g. 1234567890)
IOS_APP_ID=
APP_DOWNLOAD_URL=
